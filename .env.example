# BuildPulse standalone production configuration
# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BUILDPULSE_ORIGIN=https://buildpulse.news

# Server-only database access (prefer modern secret key; legacy service-role key remains supported)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Editorial/admin controls
ADMIN_EMAILS=
BUILDPULSE_REVIEW_SECRET=
BUILDPULSE_PREFERENCES_SECRET=
CRON_SECRET=

# Proton SMTP submission (server-side transactional mail; keep token secret)
PROTON_SMTP_HOST=
PROTON_SMTP_PORT=587
PROTON_SMTP_USERNAME=
PROTON_SMTP_TOKEN=
PROTON_FROM_EMAIL=newsroom@buildpulse.news
PROTON_FROM_NAME=BuildPulse
PROTON_REPLY_TO_EMAIL=newsroom@buildpulse.news

# Brevo campaign/newsletter delivery
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=BuildPulse
BREVO_REPLY_TO_EMAIL=
BREVO_MARKETING_LIST_ID=
BUILDPULSE_FOUNDER_TEST_LIST_ID=
BREVO_WEBHOOK_SECRET=
MARKETING_UNSUBSCRIBE_SECRET=

# Advertising settlement (server-side only)
# Stripe uses configured Payment Links plus the Supabase Stripe webhook.
# Crypto rails are advertised only when the corresponding destination is configured.
# ETH, BTC, XRP, USDC (Ethereum/Base), and USDT (Ethereum) have settlement verification.
# USDT on Base and the additional destination placeholders below remain disabled until a verifier/contract is approved.
BUILDPULSE_ETH_ADDRESS=
BUILDPULSE_ETH_BASE_ADDRESS=
BUILDPULSE_BTC_ADDRESS=
BUILDPULSE_USDC_ETH_ADDRESS=
BUILDPULSE_USDC_BASE_ADDRESS=
BUILDPULSE_USDT_ETH_ADDRESS=
BUILDPULSE_USDT_BASE_ADDRESS=
BUILDPULSE_XRP_ADDRESS=
BUILDPULSE_XRP_DESTINATION_TAG=
BUILDPULSE_SOL_ADDRESS=
BUILDPULSE_BNB_ADDRESS=
BUILDPULSE_POL_ADDRESS=
BUILDPULSE_TRX_ADDRESS=
BUILDPULSE_ADA_ADDRESS=
BUILDPULSE_SUI_ADDRESS=
BUILDPULSE_AVAX_ADDRESS=
# Defaults to Coinbase public spot endpoint when blank.
BUILDPULSE_CRYPTO_RATE_API_BASE=

# BuildPulse AI provider routing. Never commit real keys.
BUILDPULSE_AI_PROVIDER_ORDER=local,nvidia,openai
BUILDPULSE_LOCAL_AI_BASE_URL=
BUILDPULSE_LOCAL_AI_API_KEY=
BUILDPULSE_LOCAL_AI_MODEL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Comma-separated target locales for automated verified-story localization drafts.
BUILDPULSE_LOCALIZE_LOCALES=en,de,tr,fr,es,it,pt,nl
