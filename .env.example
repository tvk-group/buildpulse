# BuildPulse standalone production configuration
# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BUILDPULSE_ORIGIN=https://buildpulse.news

# Server-only database access (prefer modern secret key; legacy service-role key remains supported)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Editorial/admin controls
ADMIN_EMAILS=
BUILDPULSE_REVIEW_SECRET=
BUILDPULSE_PREFERENCES_SECRET=
CRON_SECRET=

# Proton SMTP submission (server-side transactional mail; keep token secret)
PROTON_SMTP_HOST=
PROTON_SMTP_PORT=587
PROTON_SMTP_USERNAME=
PROTON_SMTP_TOKEN=
PROTON_FROM_EMAIL=newsroom@buildpulse.news
PROTON_FROM_NAME=BuildPulse
PROTON_REPLY_TO_EMAIL=newsroom@buildpulse.news

# Optional Resend transactional adapter; sending remains gated by verified buildpulse.news domain status.
RESEND_API_KEY=
BUILDPULSE_TRANSACTIONAL_FROM=

# Brevo campaign/newsletter delivery
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=BuildPulse
BREVO_REPLY_TO_EMAIL=
BREVO_MARKETING_LIST_ID=
BUILDPULSE_FOUNDER_TEST_LIST_ID=
BREVO_WEBHOOK_SECRET=
MARKETING_UNSUBSCRIBE_SECRET=

# Advertising settlement (server-side only)
# Stripe uses configured Payment Links plus the Supabase Stripe webhook.
# Crypto rails are advertised only when the corresponding destination is configured.
# ETH, BTC, XRP, USDC (Ethereum/Base), and USDT (Ethereum) are the currently exposed verified settlement rails.
# BNB/POL/AVAX native EVM verification exists but remains outside the current public capability allowlist until explicitly activated.
# SOL/TRX/ADA/SUI remain disabled until dedicated chain verifiers exist; USDT Base remains disabled pending authoritative contract approval.
BUILDPULSE_ETH_ADDRESS=
BUILDPULSE_ETH_BASE_ADDRESS=
BUILDPULSE_BTC_ADDRESS=
BUILDPULSE_USDC_ETH_ADDRESS=
BUILDPULSE_USDC_BASE_ADDRESS=
BUILDPULSE_USDT_ETH_ADDRESS=
BUILDPULSE_USDT_BASE_ADDRESS=
BUILDPULSE_XRP_ADDRESS=
BUILDPULSE_XRP_DESTINATION_TAG=
BUILDPULSE_SOL_ADDRESS=
BUILDPULSE_BNB_ADDRESS=
BUILDPULSE_POL_ADDRESS=
BUILDPULSE_TRX_ADDRESS=
BUILDPULSE_ADA_ADDRESS=
BUILDPULSE_SUI_ADDRESS=
BUILDPULSE_AVAX_ADDRESS=
# Optional private EVM RPC endpoints (for example, Alchemy app endpoints).
# Keep API keys server-side; public-node fallbacks are used when blank.
BUILDPULSE_ETH_RPC_URL=
BUILDPULSE_BASE_RPC_URL=
BUILDPULSE_BNB_RPC_URL=
BUILDPULSE_POL_RPC_URL=
BUILDPULSE_AVAX_RPC_URL=
# Crypto spot-rate API base; defaults to Coinbase public spot endpoint when blank.
BUILDPULSE_CRYPTO_RATE_API_BASE=

# BuildPulse AI provider routing. Never commit real keys.
BUILDPULSE_AI_PROVIDER_ORDER=local,nvidia,openai
# Routing governance. Provider cost/latency classes are relative policy labels, not price claims.
BUILDPULSE_AI_PROVIDER_COST_LOCAL=low
BUILDPULSE_AI_PROVIDER_LATENCY_LOCAL=low
BUILDPULSE_AI_PROVIDER_COST_NVIDIA=medium
BUILDPULSE_AI_PROVIDER_LATENCY_NVIDIA=medium
BUILDPULSE_AI_PROVIDER_COST_OPENAI=medium
BUILDPULSE_AI_PROVIDER_LATENCY_OPENAI=medium
# Per-task overrides: BUILDPULSE_AI_PRIVACY_<TASK>=local_only|private_preferred|standard
# BUILDPULSE_AI_MAX_COST_<TASK>=low|medium|high
# BUILDPULSE_AI_MAX_LATENCY_<TASK>=low|medium|high
# Finance reconciliation defaults to local_only; moderation/ops default to private_preferred.
BUILDPULSE_LOCAL_AI_BASE_URL=
BUILDPULSE_LOCAL_AI_API_KEY=
BUILDPULSE_LOCAL_AI_MODEL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Comma-separated target locales for automated verified-story localization drafts.
BUILDPULSE_LOCALIZE_LOCALES=en,de,tr,fr,es,it,pt,nl

# Live market/economic data (server-only)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
# Optional: free Nasdaq Data Link account key for open datasets only
NASDAQ_DATA_LINK_API_KEY=
# TradingView website widgets require no API key. Do not add TradingView credentials for widgets.
